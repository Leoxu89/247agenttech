// Read-only combat measurements and bounded, structured combat events.
inherit F_DBASE;
#include <combat.h>
mapping *events=({});
int sequence;
string plain(mixed s) {
    string out = "";
    int escape = 0;
    if (!stringp(s)) return "";
    for (int i = 0; i < strlen(s); i++) {
        if (s[i] == 27) { escape = 1; continue; }
        if (escape) {
            if (s[i] >= 64 && s[i] <= 126 && s[i] != 91) escape = 0;
            continue;
        }
        out += s[i..i];
    }
    return out;
}
int power_at(object ob,int level,int usage){
 int str=ob->query_str(),dex=ob->query_dex(),p,exp=ob->query("combat_exp");
 if(!level)return exp/2;if(level>800)level=800;if(level<1)level=1;
 if(str<10)str=10;if(str>200)str=200;if(dex<10)dex=10;if(dex>200)dex=200;
 p=(level/6)*level*level;
 return (p+exp)/80*(usage==1?str+ob->query("str"):dex+ob->query("dex"));
}
mapping metrics(object ob){
 object weapon;mapping prep=ob->query_skill_prepare()||([]);string base="unarmed";int attack,defense,parry;
 weapon=ob->query_temp("weapon");if(objectp(weapon))base=weapon->query("skill_type");else if(sizeof(prep))base=keys(prep)[0];
 catch(attack=COMBAT_D->skill_power(ob,base,SKILL_USAGE_ATTACK));
 catch(defense=COMBAT_D->skill_power(ob,"dodge",SKILL_USAGE_DEFENSE));
 catch(parry=COMBAT_D->skill_power(ob,"parry",SKILL_USAGE_DEFENSE));
 return (["attack":attack,"dodge":defense,"parry":parry,"attack_base":base,"attack_skill":ob->query_skill_mapped(base)||base,
 "max_qi":ob->query("max_qi"),"max_jing":ob->query("max_jing"),"max_neili":ob->query("max_neili"),"str":ob->query_str(),"dex":ob->query_dex(),"con":ob->query_con(),"int":ob->query_int(),
 "armor":ob->query_temp("apply/armor"),"weapon_damage":ob->query_temp("apply/damage"),"unarmed_damage":ob->query_temp("apply/unarmed_damage")]);
}
mapping normal_metrics(object ob){mapping saved=ob->query_temp("apply"),gear=([]),p; mixed err;
 foreach(object item in all_inventory(ob))if(item->query("equipped")){mapping props=item->query(item->query("equipped")=="worn"?"armor_prop":"weapon_prop");if(mapp(props))foreach(string k,mixed v in props)if(intp(v))gear[k]=(gear[k]||0)+v;}
 ob->set_temp("apply",gear);err=catch(p=metrics(ob));if(mapp(saved))ob->set_temp("apply",saved);else ob->delete_temp("apply");if(err)return metrics(ob);return p;
}
mapping skill_metrics(object me,string sk,string *bases){
 mapping result=(["level":me->query_skill(sk,1),"attack":0,"defense":0,"effective_level":0,"active":0]);
 foreach(string base in bases){int level=me->query_skill(base,1)/2+me->query_skill(sk,1)+me->query_temp("apply/"+base),p;int defense=member_array(base,({"dodge","parry"}))>=0;
  if(base==sk)level=me->query_skill(base); // Basic skill uses the actual mapped configuration.
  p=power_at(me,level+me->query_temp(defense?"apply/defense":"apply/attack"),defense?2:1);
  if(base=="force"){result["force_level"]=level;result["meditation_limit"]=level*10;continue;}
  if(defense){if(p>result["defense"])result["defense"]=p;}else if(p>result["attack"])result["attack"]=p;
  if(level>result["effective_level"])result["effective_level"]=level;
  if(me->query_skill_mapped(base)==sk){result["active"]=1;if(defense)catch(result["defense"]=COMBAT_D->skill_power(me,base,2));else catch(result["attack"]=COMBAT_D->skill_power(me,base,1));}
 }
 return result;
}

mapping bout=([]);object owner,foe;int bout_sequence;
void begin(object attacker,object victim){object player=userp(attacker)?attacker:userp(victim)?victim:0,enemy;
 if(!objectp(player)||attacker==victim)return;enemy=player==attacker?victim:attacker;
 if(!sizeof(bout)||!bout["active"]||owner!=player||(foe!=enemy&&(!objectp(foe)||!foe->is_fighting(player)))){
 
 "/adm/daemons/pocketexpansion"->start_bout(player,enemy);
 owner=player;foe=enemy;bout=(["id":++bout_sequence,"started":time(),"active":1,"attacks":0,"hits":0,"normal_damage":0,"total_damage":0,"enemy_heal":0,"own_heal":0,"enemy_attacks":0,"enemy_hits":0]);
 }
}
mapping battle_stats(object me){if(owner!=me)return ([]);if(bout["active"]&&!me->is_fighting()){bout["active"]=0;bout["ended"]=time();}bout["elapsed"]=(bout["active"]?time():bout["ended"])-bout["started"];return copy(bout);}
void append_event(mapping e){e["id"]=++sequence;e["time"]=time();e["battle_id"]=bout["id"];events+=({e});if(sizeof(events)>100)events=events[<100..];}
string attack_skill(object ob){object w=ob->query_temp("weapon");mapping prep=ob->query_skill_prepare()||([]);string base=objectp(w)?w->query("skill_type"):sizeof(prep)?keys(prep)[0]:"unarmed";return plain(to_chinese(ob->query_skill_mapped(base)||base));}
void attack_result(object attacker,object victim,int hit,int damage){begin(attacker,victim);if(!objectp(owner))return;
 if(attacker==owner){bout["attacks"]++;if(hit){bout["hits"]++;bout["normal_damage"]+=damage;}}
 else if(victim==owner){bout["enemy_attacks"]++;if(hit)bout["enemy_hits"]++;}
}
void damage_event(object attacker,object victim,string type,int before,int after,int requested,string cause){
 string action="",skill="",defense=plain(to_chinese(victim->query_skill_mapped(objectp(victim->query_temp("weapon"))?"parry":"unarmed")||(objectp(victim->query_temp("weapon"))?"parry":"unarmed")));int loss=before>after?before-after:0;
 if(!objectp(attacker)||attacker==victim||(!userp(attacker)&&!userp(victim)))return;begin(attacker,victim);
 if(attacker->query_temp("pocket_attack_target")==victim){action=plain(attacker->query_temp("pocket_attack_action"));skill=plain(to_chinese(attacker->query_temp("pocket_attack_skill")));}
 if(skill==""&&strsrch(cause,"/kungfu/skill/")==0){string sk,move;if(sscanf(cause,"/kungfu/skill/%s/%s",sk,move)==2)skill=plain(to_chinese(sk));}
 if(skill=="")skill=attack_skill(attacker);
 if(attacker==owner && type=="qi")bout["total_damage"]+=loss;
 append_event((["attacker":plain(attacker->name()),"target":plain(victim->name()),"attacker_id":attacker->query("id"),"target_id":victim->query("id"),"action":action,"skill":skill,"defense_skill":defense,"type":type,"damage":loss,"requested":requested,"cause":cause,"kind":"hit"]));
}
varargs void miss_event(object attacker,object victim,string action,string kind,string base){
 if(!userp(attacker)&&!userp(victim))return;begin(attacker,victim);attack_result(attacker,victim,0,0);
 append_event((["attacker":plain(attacker->name()),"target":plain(victim->name()),"attacker_id":attacker->query("id"),"target_id":victim->query("id"),"action":plain(action),"skill":stringp(base)?plain(to_chinese(attacker->query_skill_mapped(base)||base)):attack_skill(attacker),"defense_skill":plain(to_chinese(victim->query_skill_mapped(kind=="dodge"?"dodge":objectp(victim->query_temp("weapon"))?"parry":"unarmed")||(kind=="dodge"?"dodge":objectp(victim->query_temp("weapon"))?"parry":"unarmed"))),"type":"qi","damage":0,"kind":kind]));
}
void heal_event(object target,int before,int after,string method){int gain=after-before;
 if(gain<1||!objectp(owner)||!bout["active"]||(!owner->is_fighting()&&target!=owner))return;
 if(target!=owner&&target!=foe)return;
 if(target==owner)bout["own_heal"]+=gain;else bout["enemy_heal"]+=gain;
 append_event((["attacker":plain(target->name()),"target":plain(target->name()),"attacker_id":target->query("id"),"target_id":target->query("id"),"kind":"heal","type":"qi","damage":gain,"skill":plain(to_chinese(target->query_skill_mapped("force")||"force")),"action":method]));
}
mapping *recent_events(){return events;}
