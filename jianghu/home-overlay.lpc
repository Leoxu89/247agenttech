inherit ROOM;
void create(){set("short","我的小院");set("long","一座属于你自己的小院。可以在人物页面管理仓库、睡觉，或在此打坐。离开后回到购房城市。\n");set("no_fight",1);set("no_clean_up",1);set("exits",(["out":"/d/city/kedian"]));setup();}
void init(){string id=this_player()->query("pocket_home_city");mapping city="/adm/daemons/pocketexpansion"->cities()[id];if(mapp(city)){set("short",city["name"]+"·我的小院");set("exits",(["out":city["exit"]]));}}
