int smaller(int a,int b);
// JSON is kept local because the minimal WASM driver omits the JSON package.
string json_encode(mixed value) {
    string *parts = ({});
    string out = "";
    if (stringp(value)) {
        for (int i = 0; i < strlen(value); i++) {
            if (value[i] == 34 || value[i] == 92) out += sprintf("%c%c", 92, value[i]);
            else if (value[i] < 32) out += sprintf("%cu%04x", 92, value[i]);
            else out += value[i..i];
        }
        return sprintf("%c%s%c", 34, out, 34);
    }
    if (pointerp(value)) {
        foreach (mixed item in value) parts += ({ json_encode(item) });
        return "[" + implode(parts, ",") + "]";
    }
    if (mapp(value)) {
        foreach (mixed key, mixed item in value) parts += ({ json_encode(key) + ":" + json_encode(item) });
        return "{" + implode(parts, ",") + "}";
    }
    return intp(value) || floatp(value) ? sprintf("%O", value) : "null";
}

// Read-only browser view. All actions still use the original player commands.
string plain(mixed s) {
    string out = "";
    int escape = 0;
    if (!stringp(s)) return "";
    for (int i = 0; i < strlen(s); i++) {
        if (s[i] == 27) { escape = 1; continue; }
        if (escape) {
            if (s[i] >= 64 && s[i] <= 126 && s[i] != 91) escape = 0;
            continue;
        }
        out += s[i..i];
    }
    return out;
}

varargs mapping item_view(object ob, object me, mapping counts, int depth) {
    string id = ob->query("id");
    string key;
    mixed aliases = ob->parse_command_id_list();
    mapping view;
    mapping skills;
    mixed topics;
    mixed goods;
    object sample;
    mixed err;
    if (pointerp(aliases) && sizeof(aliases)) {
        id = aliases[0];
        foreach (string alias in aliases) if (strsrch(alias, " ") < 0) { id = alias; break; }
    }
    if (!stringp(id) || id == "") id = "object";
    counts[id] = (counts[id] || 0) + 1;
    key = id + (counts[id] > 1 ? " " + counts[id] : "");
    view = ([ "key": file_name(ob), "source":base_name(ob), "token": key,
        "name": plain(ob->name()), "description": plain(ob->query("long")),
        "qi":ob->query("qi"),"max_qi":ob->query("max_qi"),"jing":ob->query("jing"),"max_jing":ob->query("max_jing"),
        "hostile":ob->is_fighting(me), "currency":ob->query("money_id"),
        "race": plain(ob->query("race")), "title": plain(ob->query("title")), "living": ob->is_character(), "accepts_apprentice": !!function_exists("attempt_apprentice",ob),
        "food": !!ob->query("food_supply"), "drink": !!ob->query("liquid"),
        "armor": !!ob->query("armor_type"), "weapon": !!ob->query("skill_type"), "weapon_type":plain(ob->query("skill_type")),
        "worn": !!ob->query("equipped"), "equipped":plain(ob->query("equipped")), "amount": ob->query_amount() || 1,
        "unit": plain(ob->query("unit")), "topics": ({}), "skills": ({}), "goods": ({}), "is_master":me->is_apprentice_of(ob), "public_teaching":!!function_exists("recognize_apprentice",ob) ]);
    view["coerced"]="/adm/daemons/pocketexpansion"->coerced(me,ob);
    view["container"] = !!ob->is_container();
    view["corpse"] = !!ob->is_corpse();
    view["contents"] = ({});
    if (view["container"] && depth < 1) {
        mapping inside = ([]);
        foreach (object child in all_inventory(ob)) {
            if (me->visible(child) && sizeof(view["contents"]) < 60)
                view["contents"] += ({ item_view(child,me,inside,depth+1) });
        }
    }
    if (ob->is_character() && !ob->is_corpse()) {
        if (member_array(base_name(ob),({"/d/wuguan/npc/wg_jiaotou1","/d/wuguan/npc/wg_jiaotou2","/d/wuguan/npc/wg_chen","/d/wuguan/npc/chen"}))>=0) {
            view["tuition"] = (["paid":!!me->query_temp("marks/yangzhou_paied"),
                "limit":base_name(ob)=="/d/wuguan/npc/wg_chen"?100000:base_name(ob)=="/d/wuguan/npc/chen"?3500:50000]);
        }
        view["power"]="/adm/daemons/pocketpower"->metrics(ob);
        if(view["coerced"]) {mapping lootcounts=([]);view["loot"]=({});foreach(object it in all_inventory(ob))if(!it->is_character())view["loot"]+=({item_view(it,me,lootcounts,2)});}
        topics = ob->query("inquiry");
        if (mapp(topics)) view["topics"] = keys(topics);
        skills = ob->query_skills();
        if (mapp(skills)) foreach (string sk in keys(skills)) {
            view["skills"] += ({ ([ "id": sk, "name": plain(to_chinese(sk)), "level": skills[sk], "teach_limit":view["coerced"]?skills[sk]:smaller(skills[sk]-2*me->query("betrayer"),SKILL_D(sk)->type()=="knowledge"?skills[sk]:250) ]) });
        }
        goods = ob->query("vendor_goods");
        if (pointerp(goods)) foreach (mixed path in goods) {
            if (!stringp(path)) continue;
            err = catch(sample = load_object(path));
            if (!err && objectp(sample)) view["goods"] += ({ ([
                "name": plain(sample->query("name")), "token": sample->query("id"),
                "food": !!sample->query("food_supply"), "drink": !!sample->query("liquid") ]) });
        }
    }
    return view;
}

object active_player();

int friendly_sparring(object me) {
    object other=me->query_temp("pocket_sparring");
    return objectp(other) && me->is_fighting(other) && other->is_fighting(me) &&
      !me->is_killing(other->query("id")) && !other->is_killing(me->query("id"));
}
string stop_sparring(string *args,int request_id) {
    object me=active_player(),other;
    if(!objectp(me) || !friendly_sparring(me))
      return json_encode((["ok":0,"message":"当前没有可结束的友好切磋"]));
    other=me->query_temp("pocket_sparring");
    me->remove_enemy(other); other->remove_enemy(me);
    me->delete_temp("pocket_sparring"); other->delete_temp("pocket_sparring");
    return json_encode((["ok":1,"message":"双方停手，友好切磋已结束"]));
}

string snapshot(string *args, int request_id) {
    object me, room, destination, ahead;
    mapping data, exits, counts, mine, skills, mapped, branches;
    mixed err, value;
    string time;
    int dark;
    foreach (object ob in users()) {
        if (objectp(environment(ob)) && userp(ob) &&
            (!sizeof(args) || args[0] == "" || ob->query("id") == args[0])) { me = ob; break; }
    }
    if (!objectp(me)) return json_encode(([ "ready": 0 ]));
    room = environment(me);
    if(mapp(me->query("pocket_faction_task"))) {
      mapping task=me->query("pocket_faction_task");
      if((task["stage"]=="letter"||task["stage"]=="ready_apprentice") && task["generation"] && me->query("family/generation")<=task["generation"]) {
        task["stage"]="complete"; task["message"]="师承升级已完成，可向新师父请教学艺";
      }
    }
    me->pocket_enforce_locks();
    mine = me->query_entire_dbase();
    time = NATURE_D->game_time();
    dark = room->query("outdoors") && !present("fire", me) && !wizardp(me) &&
        (strsrch(time, "亥时") >= 0 || strsrch(time, "子时") >= 0 ||
         strsrch(time, "丑时") >= 0 || strsrch(time, "寅时") >= 0);
    data = ([ "ready": 1,
        "player": ([ "id": me->query("id"), "name": plain(me->query("name")),
            "title": plain(me->query("title")), "age": me->query("age"),
            "gender": plain(me->query("gender")), "family": plain(me->query("family/family_name")),
            "master": plain(me->query("family/master_name")), "hometown": plain(me->query("hometown")),
            "qi": mine["qi"], "max_qi": mine["max_qi"], "eff_qi": mine["eff_qi"],
            "jing": mine["jing"], "max_jing": mine["max_jing"], "jing_locked":!!mine["pocket_jing_locked"], "qi_locked":!!mine["pocket_qi_locked"], "neili_locked":!!mine["pocket_neili_locked"], "neili": mine["neili"],
            "max_neili": mine["max_neili"], "tili": mine["tili"], "max_tili": mine["max_tili"],
            "food_locked":!!mine["pocket_food_locked"], "water_locked":!!mine["pocket_water_locked"], "force_effective":me->query_skill("force"), "food": mine["food"], "max_food": me->max_food_capacity(),
            "water": mine["water"], "max_water": me->max_water_capacity(),
            "job_name":plain(me->query_temp("job_name")),
            "job_done":!!(me->query_temp("mark/劈完了")||me->query_temp("mark/浇完了")||me->query_temp("mark/锄完了")||me->query_temp("mark/锯完了")||me->query_temp("mark/扫完了")||me->query_temp("mark/挑完了")),
            "job_returned":!!me->query_temp("mark/还了"),
            "exp": mine["combat_exp"], "potential": mine["potential"] - mine["learned_points"],
            "int_base":me->query("int"), "job_count":me->query_temp("mark/挑")+me->query_temp("mark/劈")+me->query_temp("mark/浇")+me->query_temp("mark/锄")+me->query_temp("mark/锯")+me->query_temp("mark/扫"),
            "job_wait":me->query_condition("wuguan_job"),"fight_ready":me->query_temp("fight_ok"),"have_letter":me->query_temp("have_letter"),"apprentice_ok":me->query_temp("apprentice_ok"), "str": me->query_str(), "int": me->query_int(), "con": me->query_con(),
            "dex": me->query_dex(), "balance": mine["balance"],
            "shen":mine["shen"], "nickname":plain(mine["nickname"]), "degree":plain(mine["degree"]),
            "eff_jing":mine["eff_jing"], "jingli":mine["jingli"], "max_jingli":mine["max_jingli"],
            "jiali":me->query("jiali"), "score":mine["score"], "weight":me->query_weight(),
            "potential_total":mine["potential"], "learned_points":mine["learned_points"],
            "str_base":mine["str"], "con_base":mine["con"], "dex_base":mine["dex"],
            "online_seconds":mine["mud_age"], "family_generation":me->query("family/generation"),
            "family_title":plain(me->query("family/title")), "fealty":me->query("family/fealty"),
            "perform_permissions":me->query("perform")||([]), "chief_task":me->query("pocket_chief_task")||([]), "faction_task":me->query("pocket_faction_task")||([]), "have_letter":!!me->query_temp("have_letter"), "apprentice_ok":!!me->query_temp("apprentice_ok"), "fight_ready":!!me->query_temp("fight_ok"), "class":plain(me->query("class")), "join_quanzhen_pending":!!me->query_temp("pending/join_quanzhen"), "sparring": friendly_sparring(me), "fighting": me->is_fighting(), "busy": me->is_busy(), "ghost": me->is_ghost() ]),
        "enemies":({}), "unconscious":!!me->query_temp("noliving/unconcious"),
        "death":(["message":plain(me->query("last_die_msg")),"by":plain(me->query("last_die_by_name")),"time":me->query("dietime")]),
        "room": ([ "river_to":room->query("to"),"river_about":plain(room->query("yell_about")), "key": file_name(room), "name": plain(room->query("short")),
            "x": room->query("coor/x"), "y": room->query("coor/y"),
            "description": plain(room->query("long")), "time": plain(time), "dark": dark,
            "details": ({}), "exits": ({}), "people": ({}), "items": ({}) ]),
        "inventory": ({}), "skills": ({}) ]);
    value = room->query("item_desc");
    if (mapp(value)) foreach (string detail in keys(value)) {
        data["room"]["details"] += ({ ([ "token": detail, "name": plain(to_chinese(detail)),
            "description": stringp(value[detail]) ? plain(value[detail]) : "" ]) });
    }
    exits = room->query("exits");
    if (mapp(exits)) foreach (string direction in keys(exits)) {
        value = exits[direction];
        if (!stringp(value)) continue;
        mixed *next = ({});
        destination = 0;
        err = catch(destination = load_object(value));
        if (!err && objectp(destination)) {
            branches=destination->query("exits");
            if (mapp(branches)) foreach (string nd, mixed np in branches) {
                if (!stringp(np)) continue;
                ahead=0;
                if (!catch(ahead=load_object(np)) && objectp(ahead)) next+=({ ([
                    "direction":nd,"to":file_name(ahead),"name":plain(ahead->query("short")) ]) });
            }
        }
        data["room"]["exits"] += ({ ([ "direction": direction,
            "name": !err && objectp(destination) ? plain(destination->query("short")) : "前方道路",
            "next":next, "to": !err && objectp(destination) ? file_name(destination) : value, "closed": room->query_door(direction, "status") & 1 ]) });
    }
    counts = ([]);
    foreach (object ob in all_inventory(room)) {
        if (ob == me) continue;
        if(ob->is_character()&&(me->is_fighting(ob)||ob->is_fighting(me))) data["enemies"]+=({item_view(ob,me,([]))});
        if (!me->visible(ob) || !stringp(ob->short())) continue;
        if (ob->is_character() && !ob->is_corpse()) {
            mapping v=item_view(ob,me,counts);
            data["room"]["people"]+=({v});

        }
        else data["room"]["items"] += ({ item_view(ob, me, counts) });
    }
    counts = ([]);
    foreach (object ob in all_inventory(me)) {
        if (me->visible(ob)) data["inventory"] += ({ item_view(ob, me, counts) });
    }
    skills = me->query_skills();
    mapped = me->query_skill_map();
    if (mapp(skills)) foreach (string sk in keys(skills)) {
        string *bases = ({}), *available = ({}), *combines=({});
        string *base_ids = ({"force","dodge","parry","sword","blade","unarmed","cuff","strike","finger","hand","claw","staff","whip","leg","hook","spear","hammer","axe","club","stick","throwing"});
        foreach (string base in base_ids) {
            mixed allowed;
            if (!catch(allowed=SKILL_D(sk)->valid_enable(base)) && allowed) available+=({base});
        }
        if (mapp(mapped)) foreach (string base, string special in mapped) if (special == sk) bases += ({ base });
        foreach(string other in keys(skills)) if(other!=sk) { mixed ok; if(!catch(ok=SKILL_D(sk)->valid_combine(other)) && ok) combines+=({other}); }
        data["skills"] += ({ ([ "id": sk, "name": plain(to_chinese(sk)), "level": skills[sk], "progress":(me->query_learned()||([]))[sk], "authorized":me->query("can_perform/"+sk)||([]), "prepared":member_array(sk,values(me->query_skill_prepare()||([])))>=0, "practice_supported":member_array("force",available)<0 && sizeof(available)>0, "power":"/adm/daemons/pocketpower"->skill_metrics(me,sk,sizeof(available)?available:member_array(sk,base_ids)>=0?({sk}):({})), "progress_max":(skills[sk]+1)*(skills[sk]+1)+1, "bases": bases, "enable_bases":available, "combines":combines, "basic":member_array(sk,base_ids)>=0 ]) });
    }
    data["player"]["coercing"]=objectp(me->query_temp("pocket_coercion"));
    data["player"]["escort"]="/adm/daemons/pocketexpansion"->escort_state(me);
    data["player"]["stats"]=me->query("pocket_stats")||([]);
    data["player"]["homes"]=me->query("pocket_homes")||([]);
    data["player"]["home_city"]=me->query("pocket_home_city");
    data["player"]["power"]="/adm/daemons/pocketpower"->metrics(me);
    data["combat_events"]="/adm/daemons/pocketpower"->recent_events();
    data["player"]["guide_progress"]=me->query("pocket_guides")||([]);
    data["player"]["milestones"]=(["qixing":me->query("qixing"),"zhangmen":me->query("zhangmen/title"),"married":me->query("married"),"xkd":me->query("xkd/ling")]);
    value=me->query_temp("last_damage_from");
    if (objectp(value)) data["death"]["last_attacker"]=plain(value->name());
    else if(stringp(value)) data["death"]["last_attacker"]=plain(value);
    data["travel"] = ([ "thd_known":!!me->query("thd/x"),"thd_stage":me->query_temp("thd_temp"),
        "thd_x":me->query("thd/x"),"thd_y":me->query("thd/y"),
        "boat_x":me->query_temp("thd_locx"),"boat_y":me->query_temp("thd_locy"),"boat_target":plain(me->query_temp("thd_target")),
        "sea_ready":!!me->query_temp("出海") ]);
    return json_encode(data);
}

int smaller(int a,int b) { return a<b?a:b; }
int bigger(int a,int b) { return a>b?a:b; }

// Explicit opt-in testing assistance, with modest repeatable progression grants.
string bless(string *args, int request_id) {
    object me, fire, money;
    string kind;
    int before, after, cap, times;
    foreach (object ob in users()) if (userp(ob) && objectp(environment(ob))) { me=ob; break; }
    if (!objectp(me) || !sizeof(args)) return json_encode(([ "ok":0, "message":"请先进入江湖" ]));
    if (me->is_ghost()) return json_encode(([ "ok":0, "message":"此功能不会复活角色" ]));
    kind=args[0];
    times=sizeof(args)>1?to_int(args[1]):1;
    if(times<1||times>100) return json_encode((["ok":0,"message":"次数须为1至100"]));
    switch (kind) {
    case "food_lock":
        cap=!me->query("pocket_food_locked"); me->set("pocket_food_locked",cap);
        if(cap) me->set("food",me->max_food_capacity());
        return json_encode((["ok":1,"locked":cap,"message":cap?"食物已补满并锁定":"已解锁食物，恢复原版消耗"]));
    case "water_lock":
        cap=!me->query("pocket_water_locked"); me->set("pocket_water_locked",cap);
        if(cap) me->set("water",me->max_water_capacity());
        return json_encode((["ok":1,"locked":cap,"message":cap?"饮水已补满并锁定":"已解锁饮水，恢复原版消耗"]));
    case "qi_lock":
        cap=!me->query("pocket_qi_locked"); me->set("pocket_qi_locked",cap);
        if(cap) { me->set("eff_qi",me->query("max_qi")); me->set("qi",me->query("max_qi")); }
        return json_encode((["ok":1,"locked":cap,"message":cap?"气血及伤势已补满并锁定":"已解锁气血，恢复原版损伤与消耗"]));
    case "neili_lock":
        cap=!me->query("pocket_neili_locked"); me->set("pocket_neili_locked",cap);
        if(cap) me->set("neili",bigger(me->query("neili"),me->query("max_neili")>0?me->query("max_neili"):300));
        return json_encode((["ok":1,"locked":cap,"message":cap?"内力已补足并锁定，不改变永久内力上限":"已解锁内力，恢复原版消耗"]));
    case "jing_lock":
        cap=!me->query("pocket_jing_locked");
        me->set("pocket_jing_locked",cap);
        if(cap) { me->set("eff_jing",me->query("max_jing")); me->set("jing",me->query("max_jing")); }
        return json_encode((["ok":1,"locked":cap,"message":cap?"精力已补满并锁定，学习不再消耗精神":"已解锁精力，恢复原版精神消耗与自然恢复"]));
    case "food":
        before=me->query("food"); cap=me->max_food_capacity(); after=smaller(cap,before+30*times);
        me->set("food",after); break;
    case "water":
        before=me->query("water"); cap=me->max_water_capacity(); after=smaller(cap,before+30*times);
        me->set("water",after); break;
    case "qi":
        before=me->query("qi"); cap=me->query("max_qi");
        me->set("eff_qi",smaller(cap,me->query("eff_qi")+100*times));
        after=smaller(me->query("eff_qi"),before+100*times); me->set("qi",after); break;
    case "neili":
        before=me->query("neili"); cap=bigger(300,me->query("max_neili")); after=smaller(cap,before+100*times);
        // Do not lower a legitimately overcharged player's current energy.
        if (after<before) after=before;
        me->set("neili",after); break;
    case "money":
        money=new("/clone/money/silver"); money->set_amount(10*times);
        if (!money->move(me)) { destruct(money); return json_encode((["ok":0,"message":"随身负重已满，请先整理行囊"])); }
        return json_encode((["ok":1,"delta":10*times,"message":"已获得"+sprintf("%d",10*times)+"两白银，可在行囊查看"]));
    case "exp":
        before=me->query("combat_exp"); after=before+10000*times; me->set("combat_exp",after); break;
    case "potential":
        me->set("pocket_potential_unlimited",1);
        before=me->query("potential"); after=before+1000*times; me->set("potential",after); break;
    case "shen_up":
        before=me->query("shen"); after=before+1000*times; me->set("shen",after); break;
    case "shen_down":
        before=me->query("shen"); after=before-1000*times; me->set("shen",after); break;
    case "jing":
        before=me->query("jing"); after=me->query("max_jing");
        me->set("eff_jing",after); me->set("jing",after); break;
    case "supplies":
        me->set("food",me->max_food_capacity()); me->set("water",me->max_water_capacity());
        return json_encode((["ok":1,"message":"食物与饮水已补满"]));
    case "light":
        if (!present("fire",me)) { fire=new("/clone/misc/fire"); fire->move(me); }
        return json_encode(([ "ok":1, "message":"随身火折已备好，夜间也能看清周围" ]));
    default: return json_encode(([ "ok":0, "message":"未知的体验功能" ]));
    }
    return json_encode(([ "ok":1, "delta":after-before, "message":after!=before ? "已调整，可继续体验江湖" : "当前已满，无需补充" ]));
}

object active_player() {
    foreach(object ob in users()) if(userp(ob)&&objectp(environment(ob))) return ob;
    return 0;
}

mixed clean_value(mixed v,int depth) {
    mapping out=([]);
    mixed *arr=({});
    if(depth>6) return 0;
    if(intp(v)||floatp(v)||stringp(v)) return v;
    if(mapp(v)) { foreach(mixed k,mixed value in v) if(stringp(k)&&!objectp(value)&&!functionp(value)) out[k]=clean_value(value,depth+1); return out; }
    if(pointerp(v)) { foreach(mixed value in v) if(!objectp(value)&&!functionp(value)) arr+=({clean_value(value,depth+1)}); return arr; }
    return 0;
}

mixed *inventory_state(object holder,int depth) {
    mixed *out=({});
    if(depth>3) return out;
    foreach(object ob in all_inventory(holder)) {
        if(ob->is_character()) continue;
        out+=({ (["base":base_name(ob),"state":clean_value(ob->query_entire_dbase(),0),
            "amount":ob->query_amount(),"equipped":ob->query("equipped"),"items":inventory_state(ob,depth+1)]) });
    }
    return out;
}

void restore_items(object holder,mixed *items,int depth) {
    object ob;
    mixed err;
    if(depth>3||!pointerp(items)||sizeof(items)>150) return;
    foreach(mixed item in items) {
        if(!mapp(item)||!stringp(item["base"])||!mapp(item["state"])) continue;
        if(strsrch(item["base"],"/clone/")!=0&&strsrch(item["base"],"/d/")!=0) continue;
        if(strsrch(item["base"],"..")>=0) continue;
        ob=0;err=catch(ob=new(item["base"]));
        if(err||!objectp(ob)) continue;
        if(ob->is_character()) { destruct(ob);continue; }
        foreach(string key,mixed value in item["state"]) if(key!="equipped") ob->set(key,value);
        ob->delete("equipped");
        if(function_exists("set_amount",ob)&&item["amount"]>0) ob->set_amount(item["amount"]);
        ob->move(holder);
        restore_items(ob,item["items"],depth+1);
        if(item["equipped"]=="worn") catch(ob->wear());
        else if(item["equipped"]=="wielded") catch(ob->wield());
    }
}

string checkpoint(string *args,int request_id) {
    object me=active_player(),link;
    string room;
    if(!objectp(me)) return json_encode((["ok":0,"message":"请先进入江湖"]));
    if(me->is_ghost()||me->query_temp("noliving")||me->is_fighting()) return json_encode((["ok":0,"message":"战斗、昏迷或死亡时不会覆盖安全存档"]));
    foreach(object ob in all_inventory(environment(me))) if(ob!=me&&ob->is_character()&&ob->is_fighting(me)) return json_encode((["ok":0,"message":"有人正在攻击你，保留此前的检查点"]));
    room=file_name(environment(me));
    if(strsrch(room,"/d/")!=0||strsrch(room,"#")>=0) return json_encode((["ok":0,"message":"渡船等临时场景中保留上一个检查点"]));
    me->set("startroom",room);
    if(me->query("potential")-me->query("learned_points")>100000) me->set("pocket_potential_unlimited",1);
    link=me->query_temp("link_ob");
    if(!objectp(link)||!link->save()||!me->save()) return json_encode((["ok":0,"message":"原版角色文件未能保存"]));
    return json_encode((["ok":1,"id":me->query("id"),"room":(["key":room,"name":plain(environment(me)->query("short"))]),
        "growth":(["exp":me->query("combat_exp"),"potential":me->query("potential")-me->query("learned_points"),"skills":me->query_skills()||([])]),
        "session":save_variable((["job_name":me->query_temp("job_name"),"mark":clean_value(me->query_temp("mark"),0),"tuition":me->query_temp("marks/yangzhou_paied"),"job_wait":me->query_condition("wuguan_job"),"fight_ready":me->query_temp("fight_ok"),"have_letter":me->query_temp("have_letter"),"apprentice_ok":me->query_temp("apprentice_ok")])),
        "inventory":save_variable(inventory_state(me,0))]));
}

string restore_checkpoint(string *args,int request_id) {
    object me=active_player(),dest;
    mixed items,err;
    if(!objectp(me)||sizeof(args)<3||args[0]!=me->query("id")) return json_encode((["ok":0,"message":"角色不符"]));
    if(strsrch(args[1],"/d/")!=0||strsrch(args[1],"..")>=0||strsrch(args[1],"#")>=0||strlen(args[2])>400000) return json_encode((["ok":0,"message":"存档位置不符"]));
    err=catch(dest=load_object(args[1]));
    if(err||!objectp(dest)||dest->is_character()) return json_encode((["ok":0,"message":"存档地点已不可用"]));
    err=catch(items=restore_variable(args[2]));
    if(err||!pointerp(items)) return json_encode((["ok":0,"message":"行囊记录损坏"]));
    foreach(object ob in all_inventory(me)) if(!ob->is_character()) { catch(ob->unequip());destruct(ob); }
    restore_items(me,items,0);
    if(sizeof(args)>3 && strlen(args[3])<10000) {
        mixed session;
        if(!catch(session=restore_variable(args[3])) && mapp(session)) {
            if(stringp(session["job_name"]) && session["job_name"]!="") me->set_temp("job_name",session["job_name"]);
            if(mapp(session["mark"])) me->set_temp("mark",session["mark"]);
            me->delete_temp("have_letter");me->delete_temp("apprentice_ok");me->delete_temp("fight_ok");
            if(session["fight_ready"] && me->query("pocket_faction_task/stage")=="ready_challenge") me->set_temp("fight_ok",1);
            if(session["have_letter"]) me->set_temp("have_letter",1);
            if(session["apprentice_ok"]) me->set_temp("apprentice_ok",1);
            if(mapp(me->query("pocket_faction_task")) && me->query("pocket_faction_task/stage")=="challenge") {
              me->set("pocket_faction_task/stage","retry");
              me->set("pocket_faction_task/message","登录中断了挑战，请重新领取全真令并交给现任师父再切磋");
            }
            if(me->query("pocket_chief_task/stage")=="challenge" || me->query("pocket_chief_task/stage")=="meet_master") {
              me->set("pocket_chief_task/stage","retry");
              me->set("pocket_chief_task/message","世界重建中断了掌门弟子流程，需回本门大堂重新挑战；正式接任后身份随角色保存");
            }
            if(session["tuition"]) me->set_temp("marks/yangzhou_paied",1);
            if(session["job_wait"]>0) me->apply_condition("wuguan_job",session["job_wait"]);
        }
    }
    me->move(dest);
    return json_encode((["ok":1]));
}

// Migrate only the known legacy login-cap mismatch. No XP or skills are edited.
string recover_potential(string *args,int request_id) {
    object me=active_player(); mapping skills, seen=([]); string id; int level, expected;
    if(!objectp(me)||sizeof(args)<2||me->is_ghost()) return json_encode((["ok":0]));
    skills=me->query_skills()||([]); expected=to_int(args[1]);
    if(to_int(args[0])!=me->query("combat_exp") || expected<=100000 || expected>2000000000 ||
       me->query("potential")-me->query("learned_points")!=100000 || sizeof(args)-2!=sizeof(skills)) return json_encode((["ok":0]));
    foreach(string pair in args[2..]) {
      if(sscanf(pair,"%s=%d",id,level)!=2 || undefinedp(skills[id]) || skills[id]!=level || seen[id]) return json_encode((["ok":0]));
      seen[id]=1;
    }
    me->set("pocket_potential_migrated",(["at":time(),"from_cap":100000,"restored":expected]));
    me->set("pocket_potential_unlimited",1);
    me->set("potential",expected+me->query("learned_points"));
    return json_encode((["ok":1,"message":"已从原存档恢复超额体验潜能，经验和武学校验保持开启"]));
}

string engage(string *args,int request_id) {
    object me=active_player(),enemy;
    if(!objectp(me)||!sizeof(args)||me->is_ghost()||me->query_temp("noliving")) return json_encode((["ok":0,"message":"当前无法迎战"]));
    if(environment(me)->query("no_fight")) return json_encode((["ok":0,"message":"此处禁止交战"]));
    foreach(object ob in all_inventory(environment(me))) if(file_name(ob)==args[0]&&ob->is_character()&&(ob->is_fighting(me)||me->is_fighting(ob))) enemy=ob;
    if(!objectp(enemy)) return json_encode((["ok":0,"message":"这个对手已离开战斗"]));
    me->fight_ob(enemy);
    me->delete("env/no_fight");
    return json_encode((["ok":1,"message":"已迎战，按原版轮次持续攻击；可随时尝试逃跑"]));
}

// Runs independently of browser panels; no rewards are granted by the UI.
void watch_sparring(object me,object npc,int recommendation) {
    if(!objectp(me)) return;
    if(!objectp(npc)) {
      if(recommendation) {me->set("pocket_faction_task/stage","retry");me->set("pocket_faction_task/message","对手已离开，推荐挑战未完成；请重新领取全真令再挑战");}
      return;
    }
    "/adm/daemons/pocketexpansion"->spar_result(me,npc);
    if(environment(me)!=environment(npc) || !me->is_fighting(npc) || !npc->is_fighting(me)) {
      if(recommendation && me->query("pocket_faction_task/stage")=="challenge" && npc->query_temp("pocket_spar_lost_to")!=me) {
        me->set("pocket_faction_task/stage","retry");
        me->set("pocket_faction_task/message","挑战已中断，尚未领取推荐信；请向马钰重新领全真令，交现任师父后再挑战");
      }
      return;
    }
    // A low-health opponent must not leave a zero-damage practice loop running.
    if(me->query("qi")*2<=me->query("max_qi") || npc->query("qi")*2<=npc->query("max_qi")) {
      if(npc->query("qi")*2<=npc->query("max_qi")) npc->set_temp("pocket_spar_lost_to",me);
      "/adm/daemons/pocketexpansion"->spar_result(me,npc);
      me->remove_enemy(npc); npc->remove_enemy(me);
      return;
    }
    call_out("watch_sparring",1,me,npc,recommendation);
}

// Deaths are transient world state, never written into player save files.
void return_npc(string home,string file,int declared,int unique) {
    object room,ob; mixed err;
    err=catch(room=load_object(home));
    if(err || !objectp(room)) return;
    // The original room ledger preserves exact spawn counts and roaming NPCs.
    if(declared) { catch(room->reset()); return; }
    foreach(object old in children(file)) {
      if(!clonep(old) || !objectp(environment(old))) continue;
      if(unique || environment(old)==room) return;
    }
    err=catch(ob=new(file));
    if(err || !objectp(ob)) return;
    ob->move(room); ob->set("startroom",home);
}
void schedule_npc_return(object npc) {
    object room; string home,file; mapping declared; int managed;
    if(previous_object()!=npc || !objectp(npc) || userp(npc)) return;
    // Quest-owned targets and temporary summons retain their scripted lifecycle.
    if(npc->query("owner") || npc->query("quest")) return;
    home=npc->query("startroom");
    if(!stringp(home) || strsrch(home,"/d/")!=0 || strsrch(home,"#")>=0) {
      if(!objectp(environment(npc))) return;
      home=base_name(environment(npc));
    }
    if(strsrch(home,"/d/")!=0 || strsrch(home,"#")>=0) return;
    room=find_object(home); file=base_name(npc);
    if(!objectp(room)) return;
    declared=room->query("objects");
    if(mapp(declared)) foreach(string key in keys(declared))
      if(key==file || key==file+".c" || key==file+".lpc") managed=1;
    call_out("return_npc",180,home,file,managed,npc->is_unique());
}

string guide_progress(string *args,int rid){
 object me=active_player();string key;
 if(!objectp(me)||sizeof(args)!=2)return json_encode((["ok":0]));key=args[0];
 if(sizeof(key)>70||sizeof(regexp(({key}),"^[a-z0-9_-]+$"))!=1)return json_encode((["ok":0]));
 if(args[1]=="0")me->delete("pocket_guides/"+key);else me->set("pocket_guides/"+key,1);
 return json_encode((["ok":1]));
}
void create() {
    seteuid(getuid());
    load_object("/adm/daemons/pocketexpansion");
    js_export("pocket_recover_potential", (: recover_potential :));
    js_export("pocket_stop_sparring", (: stop_sparring :));
    js_export("pocket_state", (: snapshot :));
    js_export("pocket_bless", (: bless :));
    js_export("pocket_checkpoint", (: checkpoint :));
    js_export("pocket_guide_progress", (: guide_progress :));
    js_export("pocket_restore", (: restore_checkpoint :));
    js_export("pocket_engage", (: engage :));
}
