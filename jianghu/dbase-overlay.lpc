// dbase.c

//#include <dbase.h>

inherit F_TREEMAP;

mapping dbase;
nosave mapping tmp_dbase;

//	The default_ob provides the default values of the dbase. It is set to
//	be master copy of an object.
nosave mixed default_ob;

mixed query_default_object() { return default_ob; }
void set_default_object(mixed ob) {
  //	if( geteuid(previous_object()) != ROOT_UID )
  //		error("dbase: Only this_object() or object with root euid can set default_ob.\n");
  if (!geteuid()) seteuid(getuid());
  default_ob = ob;
  ob->add("no_clean_up", 1);
}

// Original recovery and login code also write whole mappings. Normalize locks at
// their boundaries, including derived maximum changes, without granting growth.
void pocket_enforce_locks() {
  int cap;
  if (!mapp(dbase) || !userp(this_object()) || this_object()->is_ghost()) return;
  foreach (string resource in ({"jing","qi"})) if (dbase["pocket_"+resource+"_locked"]) {
    dbase[resource]=dbase["max_"+resource]; dbase["eff_"+resource]=dbase["max_"+resource];
  }
  if (dbase["pocket_food_locked"]) dbase["food"]=this_object()->max_food_capacity();
  if (dbase["pocket_water_locked"]) dbase["water"]=this_object()->max_water_capacity();
  cap=dbase["max_neili"]>0?dbase["max_neili"]:300;
  if (dbase["pocket_neili_locked"] && dbase["neili"]<cap) dbase["neili"]=cap;
}

mixed set(string prop, mixed data) {
  if (!mapp(dbase)) dbase = ([]);
  // Explicit player-only experience switch. Keep normal costs when unlocked.
  if ((prop == "jing" || prop == "eff_jing") && dbase["pocket_jing_locked"] &&
      userp(this_object()) && !this_object()->is_ghost() && intp(data) &&
      dbase["max_jing"] > 0 && data < dbase["max_jing"])
    data = dbase["max_jing"];

  if (userp(this_object()) && !this_object()->is_ghost() && intp(data)) {
    if ((prop == "qi" || prop == "eff_qi") && dbase["pocket_qi_locked"] &&
        dbase["max_qi"] > 0 && data < dbase["max_qi"])
      data = dbase["max_qi"];
    if (prop == "food" && dbase["pocket_food_locked"]) {
      int cap = this_object()->max_food_capacity();
      if (cap > 0 && data < cap) data = cap;
    }
    if (prop == "water" && dbase["pocket_water_locked"]) {
      int cap = this_object()->max_water_capacity();
      if (cap > 0 && data < cap) data = cap;
    }
    if (prop == "neili" && dbase["pocket_neili_locked"]) {
      int floor = dbase["max_neili"] > 0 ? dbase["max_neili"] : 300;
      if (dbase["neili"] > floor) floor = dbase["neili"];
      if (data < floor) data = floor;
    }
  }

  if (strsrch(prop, '/') != -1)
    return _set(dbase, explode(prop, "/"), data);

  dbase[prop] = data;
  if (prop=="max_qi" || prop=="max_jing" || prop=="max_neili") pocket_enforce_locks();
  return dbase[prop];
}

varargs mixed query(string prop, int raw) {
  mixed data;

  if (!mapp(dbase)) return 0;

  if (undefinedp(dbase[prop]) && (strsrch(prop, '/') != -1))
    data = _query(dbase, explode(prop, "/"));
  else
    data = dbase[prop];

  if (undefinedp(data) && default_ob)
    data = default_ob->query(prop, 1);

  if (raw) return data;

  return evaluate(data, this_object());
}

int delete(string prop) {
  if (!mapp(dbase)) return 0;

  if (strsrch(prop, '/') != -1)
    return _delete(dbase, explode(prop, "/"));
  else {
    map_delete(dbase, prop);
    return 1;
  }
}

mixed add(string prop, mixed data) {
  mixed old;

  if (!mapp(dbase) || !(old = query(prop, 1)))
    return set(prop, data);

  if (functionp(old))
    error("dbase: add() - called on a function type property.\n");

  return set(prop, old + data);
}

mapping query_entire_dbase() {
  //	if( (previous_object() != this_object())
  //	&&	(geteuid(previous_object()) != ROOT_UID) )
  //		error("dbase: query_entire_dbase() - must has root euid or be this_object().\n");

  return dbase;
}

mixed set_temp(string prop, mixed data) {
  if (!mapp(tmp_dbase)) tmp_dbase = ([]);

  if (strsrch(prop, '/') != -1)
    return _set(tmp_dbase, explode(prop, "/"), data);

  return tmp_dbase[prop] = data;
}

varargs mixed query_temp(string prop, int raw) {
  mixed data;

  if (!mapp(tmp_dbase)) return 0;

  if (strsrch(prop, '/') != -1)
    data = _query(tmp_dbase, explode(prop, "/"));
  else
    data = tmp_dbase[prop];

  if (functionp(data) && !raw)
    return (* data) (this_object());
  else
    return data;
}

int delete_temp(string prop) {
  if (!mapp(tmp_dbase)) return 0;

  if (strsrch(prop, '/') != -1)
    return _delete(tmp_dbase, explode(prop, "/"));
  else {
    map_delete(tmp_dbase, prop);
    return 1;
  }
}

mixed add_temp(string prop, mixed data) {
  mixed old;

  if (!mapp(tmp_dbase) || !(old = query_temp(prop, 1)))
    return set_temp(prop, data);

  if (functionp(old))
    error("dbase: add_temp() - called on a function type property.\n");

  return set_temp(prop, old + data);
}

mapping query_entire_temp_dbase() {
  //	if( (previous_object() != this_object())
  //	&&	(geteuid(previous_object()) != ROOT_UID) )
  //		error("dbase: query_entire_temp_dbase() - must has root euid or be this_object().\n");

  return tmp_dbase;
}
